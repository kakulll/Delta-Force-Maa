{
    "option": {
        "TradingTargetModeOption": {
            "type": "select",
            "label": "采购目标模式",
            "description": "选择交易行采购的目标品类或列表",
            "default_case": "ModeFavorites",
            "cases": [
                {
                    "name": "ModeFavorites",
                    "label": "我的收藏（推荐，监控收藏列表）",
                    "pipeline_override": {
                        "Trading.CheckTradingOpen": {
                            "next": [
                                "Trading.SelectFavoriteTab",
                                "Trading.CheckEmptyFavorite",
                                "Trading.SelectFirstFavorite"
                            ]
                        }
                    }
                },
                {
                    "name": "ModeConsumables",
                    "label": "消耗品专区（医疗箱/止疼药/急救包）",
                    "pipeline_override": {
                        "Trading.CheckTradingOpen": {
                            "next": [
                                "Trading.SelectCategoryConsumables",
                                "Trading.SelectFirstFavorite"
                            ]
                        }
                    }
                },
                {
                    "name": "ModeAmmo",
                    "label": "弹药专区（各型号子弹）",
                    "pipeline_override": {
                        "Trading.CheckTradingOpen": {
                            "next": [
                                "Trading.SelectCategoryAmmo",
                                "Trading.SelectFirstFavorite"
                            ]
                        }
                    }
                }
            ]
        },
        "TradingMaxPriceOption": {
            "type": "select",
            "label": "最高购买限价（预算）",
            "description": "当交易行价格低于或等于该限价时自动执行购买",
            "default_case": "Price5w",
            "cases": [
                {
                    "name": "Price1w",
                    "label": "10,000 (极速捡漏)",
                    "pipeline_override": {
                        "Trading.EvaluatePrice": {
                            "custom_recognition_param": {
                                "max_price": 10000
                            }
                        }
                    }
                },
                {
                    "name": "Price3w",
                    "label": "30,000 (超值捡漏)",
                    "pipeline_override": {
                        "Trading.EvaluatePrice": {
                            "custom_recognition_param": {
                                "max_price": 30000
                            }
                        }
                    }
                },
                {
                    "name": "Price5w",
                    "label": "50,000 (均衡推荐)",
                    "pipeline_override": {
                        "Trading.EvaluatePrice": {
                            "custom_recognition_param": {
                                "max_price": 50000
                            }
                        }
                    }
                },
                {
                    "name": "Price10w",
                    "label": "100,000 (快速采购)",
                    "pipeline_override": {
                        "Trading.EvaluatePrice": {
                            "custom_recognition_param": {
                                "max_price": 100000
                            }
                        }
                    }
                },
                {
                    "name": "Price20w",
                    "label": "200,000 (大额物资)",
                    "pipeline_override": {
                        "Trading.EvaluatePrice": {
                            "custom_recognition_param": {
                                "max_price": 200000
                            }
                        }
                    }
                },
                {
                    "name": "PriceUnlimited",
                    "label": "不限预算 (买入即可)",
                    "pipeline_override": {
                        "Trading.EvaluatePrice": {
                            "custom_recognition_param": {
                                "max_price": 99999999
                            }
                        }
                    }
                }
            ]
        },
        "TradingPurchaseAction": {
            "type": "select",
            "label": "购买操作模式",
            "description": "控制是否真正下单购买或仅执行价格监控",
            "default_case": "RealBuy",
            "cases": [
                {
                    "name": "RealBuy",
                    "label": "实际购买（自动执行购买与二次确认）",
                    "pipeline_override": {
                        "Trading.ClickBuyDirect": {
                            "enabled": true
                        },
                        "Trading.ConfirmBuyDialog": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "DryRun",
                    "label": "仅价格监控（安全模式，不消耗哈克币）",
                    "pipeline_override": {
                        "Trading.ClickBuyDirect": {
                            "enabled": false
                        },
                        "Trading.ConfirmBuyDialog": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "TradingAutoMaxQuantity": {
            "type": "switch",
            "label": "是否自动选择最大数量",
            "description": "购买时自动点击数量最大化按钮",
            "default_case": "Enabled",
            "cases": [
                {
                    "name": "Enabled",
                    "label": "开启",
                    "pipeline_override": {
                        "Trading.SelectMaxQuantity": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "Disabled",
                    "label": "关闭",
                    "pipeline_override": {
                        "Trading.SelectMaxQuantity": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
    },
    "task": [
        {
            "name": "Trading",
            "label": "交易行自动捡漏与采购",
            "entry": "Trading.Start",
            "option": [
                "TradingTargetModeOption",
                "TradingMaxPriceOption",
                "TradingPurchaseAction",
                "TradingAutoMaxQuantity"
            ]
        }
    ]
}
