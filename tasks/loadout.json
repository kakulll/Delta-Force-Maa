{
    "option": {
        "LoadoutPresetOption": {
            "type": "select",
            "label": "战前配装预设方案",
            "description": "选择一键自动穿戴的成套战备预设方案（突击/侦察/轻装）",
            "default_case": "PresetAssault",
            "cases": [
                {
                    "name": "PresetAssault",
                    "label": "突击方案 (高防重甲头胸 + 30格背包 + 全套医疗)",
                    "description": "高防护重甲配置，适合正面交火与要点攻坚",
                    "pipeline_override": {
                        "Loadout.SelectPreset": {
                            "expected": [
                                "突击方案",
                                "突击",
                                "重装突击"
                            ]
                        },
                        "Loadout.CheckStashHelmet": {
                            "expected": [
                                "全防头盔",
                                "5级头盔",
                                "重装头盔"
                            ]
                        },
                        "Loadout.CheckStashArmor": {
                            "expected": [
                                "重装防弹衣",
                                "5级防弹衣",
                                "突击防弹衣"
                            ]
                        },
                        "Loadout.CheckStashChestRig": {
                            "expected": [
                                "突击胸挂",
                                "4级胸挂",
                                "重型胸挂"
                            ]
                        },
                        "Loadout.CheckStashBackpack": {
                            "expected": [
                                "战术大背包",
                                "30格背包",
                                "大背包"
                            ]
                        },
                        "Loadout.CheckStashMeds": {
                            "expected": [
                                "全套手术包",
                                "高级医疗包",
                                "急救包"
                            ]
                        },
                        "Loadout.CheckStashAmmo": {
                            "expected": [
                                "5.56x45mm M995",
                                "M995",
                                "5.56穿甲弹",
                                "AP弹",
                                "5级弹药"
                            ]
                        },
                        "Loadout.SearchMissingItemInput": {
                            "input_text": "全防头盔"
                        }
                    }
                },
                {
                    "name": "PresetRecon",
                    "label": "侦察方案 (高机动轻甲 + 战术侦察头 + 中背包 + 兴奋剂)",
                    "description": "高机动高感知配置，适合中远距离游击与侦察定位",
                    "pipeline_override": {
                        "Loadout.SelectPreset": {
                            "expected": [
                                "侦察方案",
                                "侦察",
                                "战术侦察"
                            ]
                        },
                        "Loadout.CheckStashHelmet": {
                            "expected": [
                                "战术侦察头盔",
                                "4级头盔",
                                "轻量头盔"
                            ]
                        },
                        "Loadout.CheckStashArmor": {
                            "expected": [
                                "高机动防弹衣",
                                "4级防弹衣",
                                "轻甲"
                            ]
                        },
                        "Loadout.CheckStashChestRig": {
                            "expected": [
                                "侦察胸挂",
                                "轻型胸挂",
                                "战术胸挂"
                            ]
                        },
                        "Loadout.CheckStashBackpack": {
                            "expected": [
                                "中型战术背包",
                                "20格背包",
                                "便携背包"
                            ]
                        },
                        "Loadout.CheckStashMeds": {
                            "expected": [
                                "敏捷兴奋剂",
                                "医疗针",
                                "便携医疗包"
                            ]
                        },
                        "Loadout.CheckStashAmmo": {
                            "expected": [
                                "5.56x45mm M855A1",
                                "M855A1",
                                "7.62x39mm BP",
                                "4级穿甲弹"
                            ]
                        },
                        "Loadout.SearchMissingItemInput": {
                            "input_text": "战术侦察头盔"
                        }
                    }
                },
                {
                    "name": "PresetLightweight",
                    "label": "轻装方案 (经济防弹衣 + 基础轻便头 + 便携背包 + 止痛)",
                    "description": "经济跑刀低成本配置，适合快速搜资与低风险撤离",
                    "pipeline_override": {
                        "Loadout.SelectPreset": {
                            "expected": [
                                "轻装方案",
                                "轻装",
                                "基础轻装"
                            ]
                        },
                        "Loadout.CheckStashHelmet": {
                            "expected": [
                                "基础轻便头盔",
                                "3级头盔",
                                "轻便头盔"
                            ]
                        },
                        "Loadout.CheckStashArmor": {
                            "expected": [
                                "经济防弹衣",
                                "3级防弹衣",
                                "轻型防弹衣"
                            ]
                        },
                        "Loadout.CheckStashChestRig": {
                            "expected": [
                                "便携胸挂",
                                "基础胸挂",
                                "轻便胸挂"
                            ]
                        },
                        "Loadout.CheckStashBackpack": {
                            "expected": [
                                "便携小背包",
                                "基础背包",
                                "小背包"
                            ]
                        },
                        "Loadout.CheckStashMeds": {
                            "expected": [
                                "简易止痛药",
                                "急救绷带",
                                "基础止痛"
                            ]
                        },
                        "Loadout.CheckStashAmmo": {
                            "expected": [
                                "5.56x45mm M855",
                                "M855",
                                "7.62x39mm PS",
                                "3级弹药"
                            ]
                        },
                        "Loadout.SearchMissingItemInput": {
                            "input_text": "基础轻便头盔"
                        }
                    }
                }
            ]
        },
