    "task": [
        {
            "name": "LoadoutPreset",
            "label": "战前一键自动配装",
            "description": "根据预定义装备方案（突击、侦察、轻装），全自动执行仓库取件、缺件交易行自动补货、穿戴头盔/防弹衣/胸挂/背包/药品全流程，支持DryRun安全预览与4级Esc安全回退。",
            "entry": "Loadout.Start",
            "option": [
                "LoadoutPresetOption",
                "LoadoutAllowTradingBuyOption",
                "LoadoutDryRunOption",
                "LoadoutBudgetOption"
            ]
        }
