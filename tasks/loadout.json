        "LoadoutAllowTradingBuyOption": {
            "type": "select",
            "label": "缺件交易行自动采购",
            "description": "当仓库无对应预设装备时，是否自动跳转交易行采购补货",
            "default_case": "Enabled",
            "cases": [
                {
                    "name": "Enabled",
                    "label": "开启交易行自动采购补货",
                    "description": "当仓库缺少预设装备时，自动进入交易行搜索并购买最低价装备",
                    "pipeline_override": {
                        "Loadout.JumpToTrading": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "Disabled",
                    "label": "关闭交易行采购 (仅取仓库现有库存)",
                    "description": "当仓库缺少预设装备时，跳过该部件，仅穿戴仓库中现有的装备",
                    "pipeline_override": {
                        "Loadout.JumpToTrading": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "LoadoutReplenishOption": {
            "type": "select",
            "label": "缺件交易行自动采购",
            "description": "当仓库无对应预设装备时，是否自动跳转交易行采购补货",
            "default_case": "Enabled",
            "cases": [
                {
                    "name": "Enabled",
                    "label": "开启交易行自动采购补货",
                    "description": "当仓库缺少预设装备时，自动进入交易行搜索并购买最低价装备",
                    "pipeline_override": {
                        "Loadout.JumpToTrading": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "Disabled",
                    "label": "关闭交易行采购 (仅取仓库现有库存)",
                    "description": "当仓库缺少预设装备时，跳过该部件，仅穿戴仓库中现有的装备",
                    "pipeline_override": {
                        "Loadout.JumpToTrading": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "LoadoutDryRunOption": {
            "type": "select",
            "label": "配装执行模式",
            "description": "DryRun 安全预览或实战自动穿戴扣费采购",
            "default_case": "DryRun",
            "cases": [
                {
                    "name": "DryRun",
                    "label": "DryRun 安全预览模式 (不穿戴/不扣费购买)",
                    "description": "仅核对槽位与缺件清单，不执行穿戴、取件与交易行扣费购买",
                    "pipeline_override": {
                        "Loadout.EquipItem": {
                            "enabled": false
                        },
                        "Loadout.EquipGear": {
                            "enabled": false
                        },
                        "Loadout.RetrieveGear": {
                            "enabled": false
                        },
                        "Loadout.ClickBuyMissing": {
                            "enabled": false
                        },
                        "Loadout.BuyMissingItem": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "RealRun",
                    "label": "RealRun 实战配装模式 (自动穿戴全套装备并扣费补货)",
                    "description": "自动穿戴仓库匹配装备并在缺件时于交易行自动采购",
                    "pipeline_override": {
                        "Loadout.EquipItem": {
                            "enabled": true
                        },
                        "Loadout.EquipGear": {
                            "enabled": true
                        },
                        "Loadout.RetrieveGear": {
